# ================= MediODL Bot - Environment =================
# این فایل را کپی کرده و به `.env` تغییر نام دهید و مقادیر را پر کنید
# cp .env.example .env  &&  nano .env

# --- ضروری ---
BOT_TOKEN=1234567890:AAH...توکن_ربات_از_BotFather
ADMIN_IDS=123456789,987654321  # آیدی عددی ادمین‌ها (با کاما یا فاصله جدا کنید)

# --- اختیاری ---
# نام ربات در پیام‌ها
BOT_NAME=MediODL
# زبان پیش‌فرض (fa)
DEFAULT_LANG=fa

# حداکثر کیفیت ویدیو: 1080, 720, 480
MAX_VIDEO_HEIGHT=1080
# حداکثر حجم آپلود مستقیم تلگرام (مگابایت) - اگر از Local Bot API استفاده می‌کنید تا 2000 بگذارید
MAX_UPLOAD_MB=2000
# پوشه موقت دانلود
TMP_DIR=/opt/mediodl-bot/tmp
# دیتابیس
DATABASE_PATH=/opt/mediodl-bot/data/bot.db

# Local Bot API (برای فایل‌های بالای 50MB)
# اگر https://github.com/tdlib/telegram-bot-api را به صورت لوکال اجرا کرده‌اید:
BOT_API_SERVER=
BOT_API_PORT=

# لاگ
LOG_LEVEL=INFO

# --- هم‌زیستی ---
# این ربات عمداً پورت 80/443 و nginx هاست را لمس نمی‌کند
# و با 3x-ui و D_bot هیچ تداخلی ندارد
