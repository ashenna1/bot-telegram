# ================= MediGo (MediODL) Bot - Environment =================
# cp .env.example .env  &&  nano .env

# --- ضروری ---
BOT_TOKEN=1234567890:AAH...توکن_ربات_از_BotFather
ADMIN_IDS=123456789,987654321

# --- اختیاری ---
BOT_NAME=لینک قاپ
BOT_USERNAME=linkghap_bot
DEFAULT_LANG=fa
MAX_VIDEO_HEIGHT=1080
MAX_UPLOAD_MB=2000
MAX_DURATION_SEC=3600
RATE_LIMIT_PER_HOUR=20
TMP_DIR=/opt/mediodl-bot/tmp
DATABASE_PATH=/opt/mediodl-bot/data/bot.db
LOG_LEVEL=INFO

# Local Bot API برای 2GB (اختیاری)
# BOT_API_SERVER=127.0.0.1
# BOT_API_PORT=8081
# TELEGRAM_API_ID=12345
# TELEGRAM_API_HASH=abcdef

# نیازی به پرمیوم نیست - Local API تا 2GB رایگانه!
