[Unit]
Description=MediGo (MediODL) Telegram Bot - 9 Platforms Media Downloader
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mediodl-bot
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/mediodl-bot/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/mediodl-bot/venv/bin/python -m bot
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
CPUQuota=100%
MemoryMax=800M
MemoryHigh=600M
TasksMax=128
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mediodl-bot /var/log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediodl-bot

[Install]
WantedBy=multi-user.target
